{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SUBaka",
  "version": "1.0.1",
  "identifier": "com.subaka.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:client"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SUBaka 1.0.1",
        "width": 1280,
        "height": 720,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "anekomaton",
    "copyright": "Copyright © 2026 anekomaton",
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "srt",
          "ass",
          "vtt",
          "sub",
          "ssa"
        ],
        "name": "Subtitle File",
        "role": "Editor"
      },
      {
        "ext": [
          "mp4",
          "mkv",
          "webm",
          "avi",
          "mov",
          "mp3",
          "wav",
          "m4a",
          "aac",
          "flac"
        ],
        "name": "Media File",
        "role": "Viewer"
      }
    ],
    "externalBin": [
      "binaries/ffmpeg"
    ],
    "resources": [
      "resources/"
    ],
    "windows": {}
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
